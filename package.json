{
    "name": "kmaruda-laps",
    "private": true,
    "version": "2.1.0",
    "type": "module",
    "description": "KMAruda LAPS — чтение паролей локальных администраторов (LAPS) из Active Directory. Нативный LDAP и Windows LAPS, без PowerShell и RSAT.",
    "scripts": {
        "dev": "vite --port=1420 --host=0.0.0.0",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "tauri": "tauri",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src",
        "check:version": "node scripts/check-version.mjs",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts vitest.config.ts tsconfig.json tsconfig.node.json package.json eslint.config.js",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts vitest.config.ts tsconfig.json tsconfig.node.json package.json eslint.config.js"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.3.1",
        "@tauri-apps/api": "^2.12.5",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "i18next": "^26.7.2",
        "lucide-react": "^0.577.0",
        "motion": "^12.23.24",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.13",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.7.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.3.5",
        "@tauri-apps/cli": "^2.12.6",
        "@types/node": "^22.14.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@vitejs/plugin-react": "^5.0.4",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.1.14",
        "terser": "^5.51.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^6.4.6",
        "vitest": "^4.1.12"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
