# Normalize every text file to LF in the repository and in the working tree.
* text=auto eol=lf

# Binary assets: never convert or diff as text.
*.png binary
*.ico binary
*.icns binary
*.bmp binary
*.ttf binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary

# Generated or vendored content: keep out of GitHub's language stats.
dist/** linguist-generated=true
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
src-tauri/gen/** linguist-generated=true
